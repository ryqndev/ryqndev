{
    "name": "ryqndev.github.io",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "homepage": "https://ryqn.dev",
    "scripts": {
        "dev": "node scripts/dev.mjs",
        "start": "pnpm dev",
        "dev:gateway": "node scripts/dev-gateway.mjs",
        "dev:web": "pnpm --filter web dev",
        "dev:rimefire": "pnpm --filter rimefire dev",
        "build": "pnpm --filter rimefire build && pnpm --filter web build && node scripts/compose-site.mjs",
        "build:rimefire": "pnpm --filter rimefire build",
        "preview": "pnpm --filter web preview",
        "serve": "pnpm --filter web preview",
        "create-pkg": "./scripts/create-pkg.sh",
        "create-package": "./scripts/create-pkg.sh",
        "compile": "node scripts/sync-tsconfig-refs.mjs && tsc -b",
        "predeploy": "pnpm build",
        "deploy": "gh-pages -d apps/web/build --nojekyll",
        "lint": "npx stylelint \"**/*.scss\"",
        "lintfix": "npx stylelint \"**/*.scss\" --fix",
        "prepare": "husky"
    },
    "packageManager": "pnpm@10.18.1",
    "engines": {
        "node": ">=22.12.0"
    },
    "devDependencies": {
        "@eslint/js": "catalog:",
        "@ryqn/eslint-config": "^0.0.13",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "eslint": "catalog:",
        "gh-pages": "^6.3.0",
        "husky": "^9.1.7",
        "sass": "catalog:",
        "typescript": "catalog:",
        "typescript-eslint": "catalog:",
        "vite": "catalog:",
        "vite-plugin-svgr": "catalog:"
    },
    "pnpm": {
        "overrides": {
            "@types/react": "catalog:"
        }
    }
}
